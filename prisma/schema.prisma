generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}
enum Role {
  USER
  ADMIN
}
enum JobStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum Provider {
  ALIPAY
  WECHAT
  MOCK
}
enum OrderStatus {
  PENDING
  PAID
  CLOSED
  REFUNDED
}
model User {
  id String @id @default(cuid())
  email String @unique @db.VarChar(254)
  passwordHash String @db.VarChar(255)
  role Role @default(USER)
  createdAt DateTime @default(now())
  emailVerifiedAt DateTime?
  emailVerificationToken EmailVerificationToken?
  passwordResetToken PasswordResetToken?
  accountDeletionRequest AccountDeletionRequest?
  operatedAccountDeletionReviewEvents AccountDeletionReviewEvent[] @relation("AccountDeletionReviewOperator")
  sessions Session[]
  orders Order[]
  unlocks Unlock[]
  applications Application[]
  toolOrders ToolOrder[]
  toolGrants ToolGrant[]
  toolRuns ToolRun[]
  toolRunAdjustments ToolRunAdjustment[]
  toolOrderReconcileEvents ToolOrderReconcileEvent[]
  refundCases ToolRefundCase[]
  preparedRefunds ToolRefundIntent[] @relation("RefundIntentPreparer")
  approvedRefunds ToolRefundIntent[] @relation("RefundIntentApprover")
  claimedRefundDispatches ToolRefundDispatch[]
  refundInquiryEvents ToolRefundInquiryEvent[]
  acknowledgedOpsIncidents OpsAlertIncident[] @relation("OpsIncidentAcknowledgment")
  operatedOpsIncidentEvents OpsAlertIncidentEvent[] @relation("OpsIncidentEventOperator")
}
model EmailVerificationToken {
  tokenHash String @id @db.Char(64)
  userId String @unique
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}
model PasswordResetToken {
  tokenHash String @id @db.Char(64)
  userId String @unique
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}
// Non-destructive U01 privacy request: never implies financial erasure.
model AccountDeletionRequest {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  status String @default("PENDING_MANUAL_REVIEW") @db.VarChar(32)
  requestedAt DateTime @default(now())
  reviewEvents AccountDeletionReviewEvent[]
  @@index([status,requestedAt])
}
// Append-only, non-destructive manual review record. Never an approval to erase data.
model AccountDeletionReviewEvent {
  id String @id @default(cuid())
  requestId String
  request AccountDeletionRequest @relation(fields:[requestId],references:[id],onDelete:Restrict)
  operatorId String
  operator User @relation("AccountDeletionReviewOperator",fields:[operatorId],references:[id],onDelete:Restrict)
  reasonCode String @db.VarChar(40)
  recordedAt DateTime @default(now())
  @@unique([requestId,reasonCode])
  @@index([operatorId,recordedAt])
}
model Session {
  tokenHash String @id @db.Char(64)
  userId String
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}
model Category {
  id String @id @default(cuid())
  name String @unique @db.VarChar(80)
  jobs Job[]
}
model Job {
  id String @id @default(cuid())
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  title String @db.VarChar(160)
  company String @db.VarChar(160)
  city String @db.VarChar(80)
  employment String @db.VarChar(40)
  salary String @db.VarChar(80)
  summary String @db.Text
  details String @db.Text
  sourceUrl String @db.VarChar(2048)
  priceFen Int @default(0)
  status JobStatus @default(DRAFT)
  featured Boolean @default(false)
  expiresAt DateTime?
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders Order[]
  unlocks Unlock[]
  @@index([status, categoryId, publishedAt])
}
model Order {
  id String @id @default(cuid())
  userId String
  jobId String
  amountFen Int
  provider Provider
  status OrderStatus @default(PENDING)
  providerTradeId String? @unique
  activeKey String? @unique @db.Char(64)
  codeUrl String? @db.VarChar(2048)
  paymentExpiresAt DateTime?
  createdAt DateTime @default(now())
  paidAt DateTime?
  user User @relation(fields: [userId], references: [id])
  job Job @relation(fields: [jobId], references: [id])
  unlock Unlock?
  @@index([userId, createdAt])
}
model Unlock {
  userId String
  jobId String
  orderId String @unique
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  job Job @relation(fields: [jobId], references: [id])
  order Order @relation(fields: [orderId], references: [id])
  @@id([userId, jobId])
}

model AuthAttempt {
  key String @id @db.Char(64)
  count Int @default(0)
  resetAt DateTime
  @@index([resetAt])
}
model Report {
  id String @id @default(cuid())
  jobId String
  userId String
  reason String @db.VarChar(40)
  description String @db.VarChar(1000)
  status String @default("OPEN") @db.VarChar(20)
  createdAt DateTime @default(now())
  @@unique([jobId,userId])
  @@index([status,createdAt])
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}
model Application {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  title String @db.VarChar(160)
  company String @db.VarChar(160)
  status ApplicationStatus @default(SAVED)
  nextAt DateTime?
  notes String @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId,status,updatedAt])
}
model ToolOrder {
  id String @id @db.VarChar(32)
  userId String
  user User @relation(fields: [userId], references: [id])
  sku String @db.VarChar(40)
  amountFen Int
  credits Int
  provider Provider
  status OrderStatus @default(PENDING)
  activeKey String? @unique @db.Char(64)
  providerTradeId String? @unique
  codeUrl String? @db.VarChar(2048)
  paymentExpiresAt DateTime?
  paidAt DateTime?
  refundHold Boolean @default(false)
  createdAt DateTime @default(now())
  grant ToolGrant?
  reconciliationEvents ToolOrderReconcileEvent[]
  refundCases ToolRefundCase[]
  refundIntent ToolRefundIntent?
  @@index([userId,createdAt])
}
model ToolGrant {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  orderId String? @unique @db.VarChar(32)
  order ToolOrder? @relation(fields: [orderId], references: [id])
  trialKey String? @unique
  total Int
  remaining Int
  createdAt DateTime @default(now())
  runs ToolRun[]
  @@index([userId,remaining,createdAt])
}
enum ToolRunStatus {
  RESERVED
  SUCCEEDED
  FAILED
}
model ToolRun {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  grantId String
  grant ToolGrant @relation(fields: [grantId], references: [id])
  requestId String @db.VarChar(64)
  kind String @db.VarChar(30)
  status ToolRunStatus @default(RESERVED)
  createdAt DateTime @default(now())
  finishedAt DateTime?
  adjustment ToolRunAdjustment?
  @@unique([userId,requestId])
  @@index([userId,createdAt])
}

enum RefundCaseStatus {
  OPEN
  PREPARED
  REJECTED
  PROCESSING
  SUCCEEDED
  FAILED
}
model ToolRefundCase {
  id String @id @default(cuid())
  orderId String @db.VarChar(32)
  order ToolOrder @relation(fields:[orderId],references:[id])
  userId String
  user User @relation(fields:[userId],references:[id])
  reason String @db.VarChar(500)
  status RefundCaseStatus @default(OPEN)
  reviewerId String?
  reviewReason String? @db.VarChar(500)
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  intent ToolRefundIntent?
  @@index([orderId,createdAt])
  @@index([status,createdAt])
}
enum RefundIntentState {
  PREPARED
  APPROVED
}

model ToolRefundIntent {
  id String @id @default(cuid())
  caseId String @unique
  refundCase ToolRefundCase @relation(fields:[caseId],references:[id])
  orderId String @unique @db.VarChar(32)
  order ToolOrder @relation(fields:[orderId],references:[id])
  operatorId String
  operator User @relation("RefundIntentPreparer",fields:[operatorId],references:[id])
  approvedById String?
  approvedBy User? @relation("RefundIntentApprover",fields:[approvedById],references:[id],onDelete:Restrict)
  approvalReason String? @db.VarChar(500)
  approvedAt DateTime?
  outRefundNo String @unique @db.VarChar(32)
  fingerprint String @db.Char(64)
  amountFen Int
  reason String @db.VarChar(80)
  state RefundIntentState @default(PREPARED)
  createdAt DateTime @default(now())
  dispatch ToolRefundDispatch?
  @@index([operatorId,createdAt])
  @@index([approvedById,approvedAt])
}

enum RefundDispatchState {
  READY
  IN_DOUBT
  SUCCEEDED
}

model ToolRefundDispatch {
  id String @id @default(cuid())
  intentId String @unique
  intent ToolRefundIntent @relation(fields:[intentId],references:[id],onDelete:Restrict)
  outRefundNo String @unique @db.VarChar(32)
  fingerprint String @db.Char(64)
  state RefundDispatchState @default(READY)
  createdAt DateTime @default(now())
  claimedAt DateTime?
  claimantId String?
  claimant User? @relation(fields:[claimantId],references:[id],onDelete:Restrict)
  confirmedAt DateTime?
  inquiryEvents ToolRefundInquiryEvent[]
  @@index([state,createdAt])
}

model ToolRefundInquiryEvent {
  id String @id @default(cuid())
  dispatchId String
  dispatch ToolRefundDispatch @relation(fields:[dispatchId],references:[id],onDelete:Restrict)
  operatorId String
  operator User @relation(fields:[operatorId],references:[id],onDelete:Restrict)
  observed String @db.VarChar(16)
  outcome String @db.VarChar(24)
  createdAt DateTime @default(now())
  @@index([dispatchId,createdAt])
  @@index([operatorId,createdAt])
}

model ToolOrderReconcileEvent {
  id String @id @default(cuid())
  orderId String @db.VarChar(32)
  order ToolOrder @relation(fields: [orderId], references: [id])
  operatorId String
  operator User @relation(fields: [operatorId], references: [id])
  action String @db.VarChar(16)
  observed String @db.VarChar(16)
  outcome String @db.VarChar(24)
  createdAt DateTime @default(now())
  @@index([orderId,createdAt])
  @@index([operatorId,createdAt])
}

// B04/U03: Operational incident state is isolated from financial ledgers.
enum OpsAlertIncidentState {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}
model OpsAlertIncident {
  key String @id @db.VarChar(40)
  state OpsAlertIncidentState @default(OPEN)
  count Int
  openedAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  acknowledgedAt DateTime?
  acknowledgedById String?
  acknowledgedBy User? @relation("OpsIncidentAcknowledgment", fields:[acknowledgedById], references:[id], onDelete:Restrict)
  acknowledgmentNote String? @db.VarChar(500)
  resolvedAt DateTime?
  events OpsAlertIncidentEvent[]
  notificationIntents OpsIncidentNotificationIntent[]
  @@index([state,lastSeenAt])
}
model OpsAlertIncidentEvent {
  id String @id @default(cuid())
  incidentKey String @db.VarChar(40)
  incident OpsAlertIncident @relation(fields:[incidentKey],references:[key],onDelete:Restrict)
  action String @db.VarChar(20)
  count Int
  operatorId String?
  operator User? @relation("OpsIncidentEventOperator",fields:[operatorId],references:[id],onDelete:Restrict)
  note String? @db.VarChar(500)
  createdAt DateTime @default(now())
  @@index([incidentKey,createdAt])
}

// B04/U03 durable notification intent only; no sender/worker is enabled.
enum OpsNotificationIntentState {
  QUEUED
  CLAIMED
  RETRY_WAIT
  DEAD
}
model OpsIncidentNotificationIntent {
  idempotencyKey String @id @db.Char(64)
  incidentKey String @db.VarChar(40)
  incident OpsAlertIncident @relation(fields:[incidentKey],references:[key],onDelete:Restrict)
  failureEvents OpsNotificationFailureEvent[]
  deadReview OpsNotificationDeadReview?
  episodeOpenedAt DateTime
  kind String @db.VarChar(16)
  priority String @db.VarChar(8)
  dueBucket Int
  count Int
  state OpsNotificationIntentState @default(QUEUED)
  attemptCount Int @default(0)
  claimToken String? @db.VarChar(36)
  claimedAt DateTime?
  leaseExpiresAt DateTime?
  nextAttemptAt DateTime?
  failureCode String? @db.VarChar(40)
  createdAt DateTime @default(now())
  @@index([state,createdAt])
  @@index([state,leaseExpiresAt])
  @@index([incidentKey,episodeOpenedAt])
}

// Internal-only audit: one failure event per claimed attempt, no PII or token.
model OpsNotificationFailureEvent {
  id String @id @default(cuid())
  intentKey String @db.Char(64)
  intent OpsIncidentNotificationIntent @relation(fields:[intentKey],references:[idempotencyKey],onDelete:Restrict)
  attemptCount Int
  disposition String @db.VarChar(16)
  failureCode String @db.VarChar(40)
  createdAt DateTime @default(now())
  @@unique([intentKey,attemptCount])
  @@index([createdAt])
}

// Internal-only: a DEAD task can be reviewed once; never requeues or sends.
model OpsNotificationDeadReview {
  intentKey String @id @db.Char(64)
  intent OpsIncidentNotificationIntent @relation(fields:[intentKey],references:[idempotencyKey],onDelete:Restrict)
  operatorId String @db.VarChar(191)
  reasonCode String @db.VarChar(40)
  reviewedAt DateTime
  @@index([operatorId,reviewedAt])
}

model ToolRunAdjustment {
  id String @id @default(cuid())
  runId String @unique
  run ToolRun @relation(fields: [runId], references: [id])
  operatorId String
  operator User @relation(fields: [operatorId], references: [id])
  reason String @db.VarChar(500)
  createdAt DateTime @default(now())
  @@index([operatorId,createdAt])
}
