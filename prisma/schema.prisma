generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}
enum Role {
  USER
  ADMIN
}
enum JobStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum Provider {
  ALIPAY
  WECHAT
  MOCK
}
enum OrderStatus {
  PENDING
  PAID
  CLOSED
  REFUNDED
}
model User {
  id String @id @default(cuid())
  email String @unique @db.VarChar(254)
  passwordHash String @db.VarChar(255)
  role Role @default(USER)
  createdAt DateTime @default(now())
  sessions Session[]
  orders Order[]
  unlocks Unlock[]
  applications Application[]
  toolOrders ToolOrder[]
  toolGrants ToolGrant[]
  toolRuns ToolRun[]
}
model Session {
  tokenHash String @id @db.Char(64)
  userId String
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}
model Category {
  id String @id @default(cuid())
  name String @unique @db.VarChar(80)
  jobs Job[]
}
model Job {
  id String @id @default(cuid())
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  title String @db.VarChar(160)
  company String @db.VarChar(160)
  city String @db.VarChar(80)
  employment String @db.VarChar(40)
  salary String @db.VarChar(80)
  summary String @db.Text
  details String @db.Text
  sourceUrl String @db.VarChar(2048)
  priceFen Int @default(0)
  status JobStatus @default(DRAFT)
  featured Boolean @default(false)
  expiresAt DateTime?
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders Order[]
  unlocks Unlock[]
  @@index([status, categoryId, publishedAt])
}
model Order {
  id String @id @default(cuid())
  userId String
  jobId String
  amountFen Int
  provider Provider
  status OrderStatus @default(PENDING)
  providerTradeId String? @unique
  activeKey String? @unique @db.Char(64)
  codeUrl String? @db.VarChar(2048)
  paymentExpiresAt DateTime?
  createdAt DateTime @default(now())
  paidAt DateTime?
  user User @relation(fields: [userId], references: [id])
  job Job @relation(fields: [jobId], references: [id])
  unlock Unlock?
  @@index([userId, createdAt])
}
model Unlock {
  userId String
  jobId String
  orderId String @unique
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  job Job @relation(fields: [jobId], references: [id])
  order Order @relation(fields: [orderId], references: [id])
  @@id([userId, jobId])
}

model AuthAttempt {
  key String @id @db.Char(64)
  count Int @default(0)
  resetAt DateTime
  @@index([resetAt])
}
model Report {
  id String @id @default(cuid())
  jobId String
  userId String
  reason String @db.VarChar(40)
  description String @db.VarChar(1000)
  status String @default("OPEN") @db.VarChar(20)
  createdAt DateTime @default(now())
  @@unique([jobId,userId])
  @@index([status,createdAt])
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}
model Application {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  title String @db.VarChar(160)
  company String @db.VarChar(160)
  status ApplicationStatus @default(SAVED)
  nextAt DateTime?
  notes String @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId,status,updatedAt])
}
model ToolOrder {
  id String @id @db.VarChar(32)
  userId String
  user User @relation(fields: [userId], references: [id])
  sku String @db.VarChar(40)
  amountFen Int
  credits Int
  provider Provider
  status OrderStatus @default(PENDING)
  activeKey String? @unique @db.Char(64)
  providerTradeId String? @unique
  codeUrl String? @db.VarChar(2048)
  paymentExpiresAt DateTime?
  paidAt DateTime?
  createdAt DateTime @default(now())
  grant ToolGrant?
  @@index([userId,createdAt])
}
model ToolGrant {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  orderId String? @unique @db.VarChar(32)
  order ToolOrder? @relation(fields: [orderId], references: [id])
  trialKey String? @unique
  total Int
  remaining Int
  createdAt DateTime @default(now())
  runs ToolRun[]
  @@index([userId,remaining,createdAt])
}
enum ToolRunStatus {
  RESERVED
  SUCCEEDED
  FAILED
}
model ToolRun {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  grantId String
  grant ToolGrant @relation(fields: [grantId], references: [id])
  requestId String @db.VarChar(64)
  kind String @db.VarChar(30)
  status ToolRunStatus @default(RESERVED)
  createdAt DateTime @default(now())
  finishedAt DateTime?
  @@unique([userId,requestId])
  @@index([userId,createdAt])
}
