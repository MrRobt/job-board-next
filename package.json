{
  "name": "job-board-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "node --conditions=react-server --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "release:smoke": "node scripts/ci-http-smoke.mjs",
    "release:preflight": "node scripts/prelaunch-env-guard.mjs",
    "auth:retention": "node --conditions=react-server --import tsx scripts/prune-auth.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0",
    "server-only": "^0.0.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "@types/qrcode": "^1.5.5"
  }
}
